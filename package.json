{
  "name": "homeplan",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "styles:sync": "node scripts/sync-styles.mjs && tsx scripts/sync-tokens.ts && prettier --write src/design-system/styles/tokens.tw.css",
    "geometry:walls": "tsx scripts/geometry-walls.ts",
    "viewer:focus": "tsx scripts/check-room-focus.ts",
    "strips:check": "tsx scripts/check-strip-light.ts",
    "windows:sun": "tsx scripts/check-window-sun.ts",
    "sky:check": "tsx scripts/check-sky-light.ts",
    "lights:topology": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-light-topology.mjs",
    "frames:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-frames.mjs",
    "slabs:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-slabs.mjs",
    "stairs:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-stairs.mjs",
    "yards:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-yards.mjs",
    "roofs:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-roofs.mjs",
    "editor:selection": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-editor-selection.mjs",
    "agent:check": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-agent-tools.mjs && npm run agent:templates",
    "agent:templates": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/check-agent-template-tools.mjs",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo-houses": "tsx scripts/seed-demo-houses.ts",
    "demo:build": "tsx scripts/build-demo-houses.ts",
    "templates:build": "tsx scripts/build-templates.ts",
    "materials:build": "tsx scripts/build-materials.ts",
    "materials:check": "tsx scripts/check-materials.ts",
    "seed:multistorey": "tsx scripts/seed-multistorey.ts",
    "seed:stress": "tsx scripts/seed-stress.ts",
    "ha:conditions": "tsx scripts/ha-conditions.ts",
    "build:ha-viewer": "vite build --config vite.ha-viewer.config.ts && vite build --config vite.ha-viewer.config.ts --mode loader && node --import tsx scripts/build-ha-artifact.ts",
    "ha:package": "npm run build:ha-viewer && python3 scripts/package-ha.py",
    "ha:check": "node scripts/check-ha.mjs",
    "version:check": "tsx scripts/check-version.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "app:check": "tsx scripts/check-app.ts",
    "site:dev": "vite --config vite.website.config.ts",
    "demo:ha-cards": "node scripts/build-ha-cards.mjs",
    "demo:data": "tsx scripts/build-live-demo-data.ts",
    "site:build": "npm run demo:ha-cards && npm run demo:data && vite build --config vite.website.config.ts && vite build --config vite.live-demo.config.ts",
    "site:preview": "vite preview --config vite.website.config.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.11",
    "@fastify/type-provider-typebox": "6.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clipper2-ts": "2.0.1",
    "diff": "9.0.0",
    "fastify": "5.12.8",
    "fflate": "0.8.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "immer": "11.2.10",
    "isomorphic-git": "1.44.13",
    "lit": "3.3.3",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sharp": "0.35.5",
    "suncalc": "2.1.4",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "typebox": "1.4.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
