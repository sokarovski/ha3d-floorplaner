# Copy to .env.local (untracked) and adjust. Read by vite.config.ts for `npm run dev`.
# Home Assistant origins allowed to load the dev viewer and call /api (comma-separated).
HOMEPLAN_HA_ORIGINS=http://homeassistant.local:8123
# Extra dev-server deny globs for local-only folders (comma-separated).
# HOMEPLAN_DEV_DENY=
